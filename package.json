{
  "name": "voucher-redeem",
  "productName": "Voucher Redeem",
  "version": "1.0.0",
  "description": "Offline voucher issuing and redemption using encrypted, signed PDF417 vouchers.",
  "author": "Voucher Redeem",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:issuer": "node scripts/dev.mjs --role=issuer",
    "dev:redeemer": "node scripts/dev.mjs --role=redeemer",
    "issuer": "electron . --role=issuer",
    "redeemer": "electron . --role=redeemer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:mac": "npm run build && electron-builder --mac",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "^4.11.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zxing-wasm": "^3.1.5"
  }
}
